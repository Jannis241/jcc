--- include/vector.h
+++ include/vector.h
@@ -22,12 +22,37 @@ static inline void Name##_init(Name *v) {                                         \
 }                                                                   \
 	                                                                    \
-static inline void Name##_push(Name *v, T value) {                                \
+static inline bool Name##_push(Name *v, T value) {                                \
+    if (v == NULL) {                                                \
+        return false;                                               \
+    }                                                               \
+                                                                    \
     if (v->len >= v->cap) {                                         \
-        v->cap = v->cap == 0 ? 256 : v->cap * 2;                      \
-        v->data = realloc(v->data, v->cap * sizeof(T));             \
+        size_t new_cap;                                             \
+                                                                    \
+        if (v->cap == 0) {                                          \
+            new_cap = 256;                                          \
+        } else {                                                    \
+            if (v->cap > SIZE_MAX / 2) {                            \
+                return false;                                       \
+            }                                                       \
+            new_cap = v->cap * 2;                                   \
+        }                                                           \
+                                                                    \
+        if (new_cap > SIZE_MAX / sizeof(T)) {                       \
+            return false;                                           \
+        }                                                           \
+                                                                    \
+        T *new_data = realloc(v->data, new_cap * sizeof(T));        \
+        if (new_data == NULL) {                                     \
+            return false;                                           \
+        }                                                           \
+                                                                    \
+        v->data = new_data;                                         \
+        v->cap = new_cap;                                           \
     }                                                               \
     v->data[v->len++] = value;                                      \
-}                                                                   \
+    return true;                                                    \
+}
 	                                                                    \
 
 #endif
