// features.jc
// Vollstaendiges Syntax-Beispiel fuer den aktuellen Lexer und Parser.
// Nur Zeilenkommentare mit // sind Teil der Syntax.

struct Empty {
}

struct Point {
    x: int,
    y: int,
}

struct Player {
    name: String,
    pos: Point,
    hp: int,
    inventory: [String],
    path: [Point],
    matrix: [[int]],
}

enum EmptyEnum {
}

enum Color {
    Red,
    Green,
    Blue,
}

enum Result {
    Ok,
    Err,
    Unknown,
}

const answer: int = 42;
const pi: float = 3.1415;
const enabled: bool = true;
const disabled: bool = false;

const letter: char = 'j';
const newline: char = '\n';
const tab_char: char = '\t';
const carriage_return: char = '\r';
const slash_char: char = '\\';
const quote_char: char = '\'';
const double_quote_char: char = '\"';

const text: String = "hello jcc";
const escaped_text: String = "line\nnext\tindent\rend";
const quoted_text: String = "quote: \" slash: \\";

const empty_numbers: [int] = [];
const numbers: [int] = [1, 2, 3, 4];
const nested_numbers: [[int]] = [[1, 2], [3, 4]];

const empty_struct: Empty = Empty {};
const origin: Point = Point { x: 0, y: 0 };
const favorite: Color = Color::Green;

const arithmetic: int = 1 + 2 * 3 - 4 / 2 % 2;
const grouped: int = (1 + 2) * -(3 + 4);
const unary_plus: int = +answer;
const comparisons: bool = answer < 100 && answer <= 42 && answer > 0 && answer >= 42;
const equality: bool = answer == 42 && answer != 0;
const logic: bool = !disabled && enabled || false;

const nested_call: int = parse("123", add(1, 2), numbers[0]);
const field_index_call: int = spawn_player("Ada").inventory[0].len();

fn add(a: int, b: int) => int {
    return a + b;
}

fn first(values: [int]) => int {
    return values[0];
}

fn identity_with_trailing_param(value: int,) => int {
    return value;
}

fn make_numbers() => [int] {
    return [1, 2, 3];
}

fn empty_function() {
}

fn implicit_void() {
    return;
}

fn explicit_void() => void {
    print("string", text, escaped_text, quoted_text);
    print("char", letter, newline, tab_char, carriage_return, slash_char, quote_char, double_quote_char);
    print("bool", enabled, disabled);
    print("number", answer, pi);
    return;
}

fn distance_squared(a: Point, b: Point) => int {
    let dx: int = a.x - b.x;
    let dy: int = a.y - b.y;

    {
        let local: int = (dx + dy) * -1;
        local++;
        local--;
    }

    return dx * dx + dy * dy;
}

fn spawn_player(name: String) => Player {
    return Player {
        name: name,
        pos: Point { x: 10, y: 20 },
        hp: 100,
        inventory: ["sword", "potion"],
        path: [origin, Point { x: 1, y: 2 }],
        matrix: [[1, 2], [3, 4]],
    };
}

fn classify(value: int) => Result {
    if (value < 0) {
        return Result::Err;
    } else if (value == 0) {
        print("zero");
    } else {
        print("positive");
    }

    if (value != answer) {
        print("not answer");
    }

    return Result::Ok;
}

fn loops(limit: int) => int {
    let i: int = 0;

    while (i < limit) {
        i++;

        if (i == 2) {
            continue;
        }

        if (i >= 5) {
            break;
        }
    }

    for (let j: int = 0; j < 3; j++) {
        print("for-let", j);
    }

    for (i = 0; i < limit; i += 1) {
        print("for-assign", i);
    }

    return i;
}

fn assignments() => int {
    let value: int = 10;
    let other: int = 20;
    let final: int = 30;
    let values: [int] = make_numbers();
    let player: Player = spawn_player("Grace");

    value = other = final;
    value = value + 1;
    value += 2;
    value -= 3;
    value *= 4;
    value /= 2;

    values[0] = value;
    values[1] += 3;
    values[2] -= 1;
    values[0] *= 2;
    values[1] /= 2;

    player.pos.x = values[0];
    player.pos.y += values[1];
    player.hp -= 10;
    player.hp *= 2;
    player.hp /= 3;

    return player.pos.x + player.pos.y + player.hp;
}

fn postfix_examples() => int {
    let values: [int] = make_numbers();
    let player: Player = spawn_player("Lin");
    let first_value: int = values[0];
    let chained: int = spawn_player("Chained").path[0].x;

    first_value++;
    first_value--;
    print(player.name.len(), player.inventory[1], player.path[0].x, chained);

    return first_value + chained;
}

fn main() => int {
    let player: Player = spawn_player("Ada");
    let result: Result = classify(answer);
    let total: int = distance_squared(origin, player.pos) + loops(10);
    let score: int = assignments() + postfix_examples() + first(numbers);
    let id: int = identity_with_trailing_param(score);

    implicit_void();
    explicit_void();

    if (result == Result::Ok && total > 0 || score != 0) {
        print("ok", player.name, total, score, id, favorite);
        return 0;
    } else {
        print("error", Result::Unknown);
    }

    return 1;
}
