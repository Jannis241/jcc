struct Point {
    x: int,
    y: int,
}

struct Player {
    name: String,
    pos: Point,
    hp: int,
    inventory: [String],
}

enum Color {
    Red,
    Green,
    Blue,
}

enum Result {
    Ok,
    Err,
}

const answer: int = 42;
const pi: float = 3.1415;
const enabled: bool = true;
const disabled: bool = false;
const newline: char = '\n';
const greeting: String = "hello\tjcc";

const numbers: [int] = [1, 2, 3, 4];
const origin: Point = Point { x: 0, y: 0 };
const favorite: Color = Color::Green;

const precedence: int = 1 + 2 * 3 - 4 / 2 % 2;
const grouped: int = (1 + 2) * -(3 + 4);
const logic: bool = !disabled && enabled || answer >= 40 && answer != 0;
const nested_call: int = parse("123", add(1, 2), numbers[0]);
const field_and_index: int = spawn_player("Ada").inventory[0].len();

fn add(a: int, b: int) => int {
    return a + b;
}

fn distance_squared(a: Point, b: Point) => int {
    let dx: int = a.x - b.x;
    let dy: int = a.y - b.y;
    return dx * dx + dy * dy;
}

fn spawn_player(name: String) => Player {
    return Player {
        name: name,
        pos: Point { x: 10, y: 20 },
        hp: 100,
        inventory: ["sword", "potion"],
    };
}

fn update_player(player: Player, damage: int) => Result {
    let current_hp: int = player.hp;

    current_hp -= damage;
    current_hp += 5;
    current_hp *= 2;
    current_hp /= 2;

    player.hp = current_hp;
    player.pos.x++;
    player.pos.y--;
    player.inventory[0] = "used sword";

    if player.hp <= 0 {
        return Result::Err;
    } else {
        return Result::Ok;
    }
}

fn sum_until_limit(values: [int], limit: int) => int {
    let total: int = 0;
    let i: int = 0;

    while i < values.len() {
        if total >= limit {
            break;
        }

        total += values[i];
        i++;
        continue;
    }

    return total;
}

fn count_items(items: [String]) => int {
    let count: int = 0;

    for item in items {
        if item == "" {
            continue;
        }

        count++;
    }

    return count;
}

fn main() => int {
    let player: Player = spawn_player("Ada");
    let result: Result = update_player(player, 12);
    let total: int = sum_until_limit(numbers, 10);

    if result == Result::Ok && total > 0 {
        print("ok", player.name, total);
        return 0;
    }

    print("error");
    return 1;
}
