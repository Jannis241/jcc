struct Point {
    x: int,
    y: int,
}

struct Player {
    name: String,
    pos: Point,
    hp: int,
    inventory: [String],
}

enum Color {
    Red,
    Green,
    Blue,
}

enum Result {
    Ok,
    Err,
}

const answer: int = 42;
const pi: float = 3.1415;
const enabled: bool = true;
const disabled: bool = false;
const newline: char = '\n';
const greeting: String = "hello\tjcc";

const numbers: [int] = [1, 2, 3, 4];
const origin: Point = Point { x: 0, y: 0 };
const favorite: Color = Color::Green;

const precedence: int = 1 + 2 * 3 - 4 / 2 % 2;
const grouped: int = (1 + 2) * -(3 + 4);
const logic: bool = !disabled && enabled || answer >= 40 && answer != 0;
const nested_call: int = parse("123", add(1, 2), numbers[0]);
const field_and_index: int = spawn_player("Ada").inventory[0].len();

fn add(a: int, b: int) => int {
    return a + b;
}

fn log_all() => void {
    print("string", greeting);
    print("char", newline);
    print("bool", enabled, disabled);
    print("number", answer, pi);
    return;
}

fn distance_squared(a: Point, b: Point) => int {
    let dx: int = a.x - b.x;
    let dy: int = a.y - b.y;

    {
        let local: int = (dx + dy) * -1;
        local++;
        local--;
    }

    return dx * dx + dy * dy;
}

fn spawn_player(name: String) => Player {
    return Player {
        name: name,
        pos: Point { x: 10, y: 20 },
        hp: 100,
        inventory: ["sword", "potion"],
    };
}

fn classify(value: int) => Result {
    if (value < 0) {
        return Result::Err;
    } else if (value == 0) {
        print("zero");
    } else {
        print("positive");
    }

    return Result::Ok;
}

fn loops(limit: int) => int {
    let i: int = 0;

    while (i < limit) {
        i++;

        if (i == 2) {
            continue;
        }

        if (i >= 5) {
            break;
        }
    }

    for (let j: int = 0; j < 3 ; j++) {
        print("for", j);
    }

    return i;
}

fn main() => int {
    let player: Player = spawn_player("Ada");
    let result: Result = classify(answer);
    let total: int = distance_squared(origin, player.pos) + loops(10);

    log_all();

    if (result == Result::Ok && total > 0) {
        print("ok", player.name, total);
        return 0;
    } else {
        print("error");
    }

    return 1;
}
